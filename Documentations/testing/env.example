# Copy to env.local and adjust for your lab:
#   cp env.example env.local
#   source env.local

# Base URL of the administrative interface (no trailing slash)
export VD_BASE_URL="https://lab.example"

# Session login (used when VD_TOKEN is empty)
export VD_USERNAME="admin"
export VD_PASSWORD="admin"
export VD_DOMAIN=""

# Optional Bearer token (skips login when set)
export VD_TOKEN=""

# Cookie jar for session-based tests
export VD_COOKIE_JAR="/tmp/voipdomain-test-cookies.txt"

# Gearman (router smoke tests)
export GEARMAN_HOST="127.0.0.1"
export GEARMAN_PORT="4730"

# Optional: server ID for scoped hook tests
export VD_SERVER_ID="1"
