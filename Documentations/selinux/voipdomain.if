## <summary>VoIP Domain policy interfaces</summary>

########################################
## <summary>
##      Execute voipdomain daemon in the voipdomain domain.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed to transition.
##      </summary>
## </param>
#
interface(`voipdomain_domtrans',`
        gen_require(`
                type voipdomain_t, voipdomain_exec_t;
        ')

        corecmd_search_bin($1)
        domtrans_pattern($1, voipdomain_exec_t, voipdomain_t)
')

########################################
## <summary>
##      Read voipdomain configuration files.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`voipdomain_read_config',`
        gen_require(`
                type voipdomain_etc_t;
        ')

        files_search_etc($1)
        read_files_pattern($1, voipdomain_etc_t, voipdomain_etc_t)
')

########################################
## <summary>
##      Manage voipdomain configuration files.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`voipdomain_manage_config',`
        gen_require(`
                type voipdomain_etc_t;
        ')

        files_search_etc($1)
        manage_files_pattern($1, voipdomain_etc_t, voipdomain_etc_t)
')

########################################
